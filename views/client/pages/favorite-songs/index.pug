extends ../../layouts/default.pug
include ../../mixins/box-head

block main 
    .container.my-3
        .row 
            .col-12     
                +box-head(titlePage)

        .row 
            each favoriteSong in favoriteSongs   
                .col-6.mb-3
                    div(class="song-item")
                        div(class="inner-image")
                            a(href=`/songs/detail/${favoriteSong.songDetail.slug}`)
                                img(src=favoriteSong.songDetail.avatar)
                        div(class="inner-content")
                            div(class="inner-title")
                                a(href=`/songs/detail/${favoriteSong.songDetail.slug}`) #{favoriteSong.songDetail.title}
                            div(class="inner-singer") <i class="fa-solid fa-microphone-lines"></i> #{favoriteSong.singerDetail.fullName} 
                            div(class="inner-heart active" button-favorite=favoriteSong.songId)
                                <i class="fa-regular fa-heart"></i> Yêu thích
                            div(class="inner-time") <i class="fa-regular fa-clock"></i> 20/10/2023
